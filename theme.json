{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "751px",
			"wideSize": "1100px"
		},
		"color": {
			"defaultPalette": true,
			"defaultGradients": true,
			"customDuotone": false,
			"palette": [
				{ "slug": "philosophy-ink", "color": "#151515", "name": "Ink" },
				{ "slug": "philosophy-body", "color": "#3f3f3f", "name": "Body text" },
				{ "slug": "philosophy-muted", "color": "#888888", "name": "Muted" },
				{ "slug": "philosophy-rule", "color": "#e8e8e8", "name": "Rule" },
				{ "slug": "philosophy-paper", "color": "#ffffff", "name": "Paper" },
				{ "slug": "philosophy-accent", "color": "#0054a5", "name": "Accent" },
				{ "slug": "philosophy-night", "color": "#050505", "name": "Night" }
			]
		},
		"typography": {
			"customFontSize": true,
			"lineHeight": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "philosophy-serif",
					"name": "Libre Baskerville",
					"fontFamily": "\"Libre Baskerville\", Georgia, \"Times New Roman\", serif"
				},
				{
					"slug": "philosophy-sans",
					"name": "Montserrat",
					"fontFamily": "\"Montserrat\", \"HelveticaNeue\", \"Helvetica Neue\", Helvetica, Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "14px", "name": "Small" },
				{ "slug": "medium", "size": "17px", "name": "Medium" },
				{ "slug": "large", "size": "22px", "name": "Large" },
				{ "slug": "x-large", "size": "30px", "name": "Extra large" }
			]
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"units": [ "px", "em", "rem", "%", "vh", "vw" ]
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--philosophy-paper)",
			"text": "var(--wp--preset--color--philosophy-body)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--philosophy-serif)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.8"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--philosophy-accent)"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--philosophy-sans)",
					"fontWeight": "600",
					"lineHeight": "1.3"
				},
				"color": {
					"text": "var(--wp--preset--color--philosophy-ink)"
				}
			}
		}
	}
}
